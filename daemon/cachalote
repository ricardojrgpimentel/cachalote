#!/system/bin/sh
# cachalote — controlo do daemon no dispositivo (corre como root, via su).
#
#   cachalote start | stop | restart | status | logs [n] | env
#   cachalote app-token [--rotate] | app-info
#   cachalote web-start | web-stop | web-status      (interface completa do DSH)
#
# Layout:
#   BASE/runtime/bin/node                          runtime Node arm64
#   BASE/kernel/dsh/node_modules/@deepseek-ai/dsh  kernel + patches + plugin cachalote-tools
#   BASE/home/                                     DSH_HOME (perfis, sessões, .env, cordis.patch.yml)
#   BASE/bin/bash                                  shim -> /system/bin/sh
#   BASE/run/cachalote.sock                        socket AF_UNIX (0600) do motor ACP
#   BASE/run/web.pid                               engine do perfil "web" (interface completa)
#   BASE/logs/{daemon,engine,web}.log
set -u

# A base por omissão é **onde este script vive** (…/bin/cachalote → a base é a pasta de cima):
# um CLI instalado em /data/local/tmp/cachalote tem de gerir ESSE daemon, não o root. Sem isto,
# correr o CLI do Shizuku sem variável de ambiente matava/geria o daemon errado (aconteceu).
if [ -n "${CACHALOTE_BASE:-}" ]; then
  BASE="$CACHALOTE_BASE"
else
  _AQUI="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)"
  if [ -n "$_AQUI" ] && [ -f "$_AQUI/bridge.cjs" ]; then BASE="$_AQUI"; else BASE="/data/adb/cachalote"; fi
fi
SOCK="$BASE/run/cachalote.sock"
PIDFILE="$BASE/run/daemon.pid"
WEBPID="$BASE/run/web.pid"
NODE="$BASE/runtime/bin/node"
# O próprio node precisa das .so do runtime (libz.so.1 & cia).
LD_LIBRARY_PATH="$BASE/runtime/lib"
export LD_LIBRARY_PATH
PATH="$BASE/bin:$BASE/runtime/bin:$PATH"
export PATH

pid_of() { [ -f "$PIDFILE" ] && cat "$PIDFILE" 2>/dev/null; }
# O daemon está vivo? O pidfile é a via rápida; **sem** pidfile válido (o `stop` pode tê-lo
# apagado depois de outro `start`, ou o pid foi reaproveitado) um bridge desta base a correr conta
# — senão o `status` dizia «PARADO» com ele à escuta no porto (visto no S10+ em 2026-10-21).
alive() {
  p="$(pid_of)"
  if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then return 0; fi
  [ -n "$(bridges_a_correr)" ]
}

# Pids de bridges nossos, pelo caminho **exacto** do bridge.
#
# Antes isto varria `/proc` inteiro e corria `tr '\0' ' ' < /proc/<pid>/cmdline` **por cada
# processo** — mil e tal por chamada, e o `alive()` chama-o a partir do watchdog. No S10+, em
# 2026-10-21, um desses `tr` ficou a 100 % de CPU durante uma hora (e o load average em 13, o
# telefone quente na mão do autor). O `pgrep -f` ancora no início da linha de comando: é um
# processo, instantâneo, e não apanha o próprio `su -c 'pgrep …'` que faz a pergunta.
bridges_a_correr() {
  pgrep -f "^$NODE $BASE/bridge.cjs" 2>/dev/null | sort -u
}

# Mata os bridges antigos e **espera** por eles.
#
# O bridge leva até 3 s a sair de propósito (`shutdown()` dá esse tempo ao motor para morrer). O
# `start` esperava 1 s, declarava «dono diferente» e arrancava outro à mesma -- ficavam **dois
# bridges** a correr, cada um com o seu motor, e o pidfile a apontar para um deles. Foi o que se viu
# no S10+ em 2026-10-16 (e a razão pela qual os processos se acumulavam entre reinícios).
matar_bridges_antigos() {
  local pids p
  pids="$(bridges_a_correr)"
  [ -n "$pids" ] || return 0
  for p in $pids; do
    echo "a parar o daemon antigo (pid $p)"
    kill "$p" 2>/dev/null || true
  done
  # Até 8 s a sair por bem; quem ficar leva SIGKILL.
  local i
  for i in 1 2 3 4 5 6 7 8; do
    sleep 1
    pids="$(bridges_a_correr)"
    [ -n "$pids" ] || return 0
  done
  for p in $pids; do
    if kill -9 "$p" 2>/dev/null; then
      echo "  (o pid $p não saiu a bem; terminado à força)"
    else
      echo "  (o pid $p não é nosso para matar — dono diferente)"
    fi
  done
  sleep 1
}
port_open() { "$NODE" -e 'require("node:net").connect(Number(process.argv[1]),"127.0.0.1").on("connect",()=>process.exit(0)).on("error",()=>process.exit(1))' "$1" 2>/dev/null; }

# ---------------------------------------------------------------- porto

# O porto do canal vem de `home/port` — e a regra é uma só, a mesma do `install.sh`: a base root
# (`/data/adb/cachalote`) usa 39731; **qualquer outra** (o Shizuku, em `/data/local/tmp/cachalote`)
# usa 39733. É isso que deixa os dois daemons coexistirem no mesmo telefone.
#
# Porque é que isto vive aqui e não só no instalador: o `start` é a porta por onde passam todos os
# caminhos (a app, o `service.d` do Magisk, o watchdog, o `install.sh`). Uma instalação antiga feita
# pela app não tinha `home/port`, e o daemon ficava no porto do root — a app em modo Shizuku
# ligava-se ao daemon errado e o sintoma era «token inválido» (S10+, 2026-10-21).
porto_da_base() {
  if [ -n "${CACHALOTE_PORT:-}" ]; then echo "$CACHALOTE_PORT"; return 0; fi
  local p=""
  [ -f "$BASE/home/port" ] && p="$(tr -d '[:space:]' < "$BASE/home/port" 2>/dev/null)"
  if [ -n "$p" ]; then echo "$p"; return 0; fi
  if [ "$BASE" = "/data/adb/cachalote" ]; then echo 39731; else echo 39733; fi
}

# Escreve `home/port` se faltar e devolve o porto. Idempotente: quem já o tem não vê diferença.
garantir_porto() {
  local p
  p="$(porto_da_base)"
  mkdir -p "$BASE/home" 2>/dev/null || true
  printf '%s\n' "$p" > "$BASE/home/port" 2>/dev/null || true
  chmod 644 "$BASE/home/port" 2>/dev/null || true
  echo "$p"
}

# Para o daemon e todos os bridges desta base. **Não** mexe no cadeado: quem chama decide (o
# `stop` pega-o; o `start` já o tem na mão e não pode voltar a pedi-lo).
parar_de_facto() {
  if ! alive && [ -z "$(bridges_a_correr)" ]; then
    rm -f "$PIDFILE" "$SOCK"
    return 1
  fi
  alive && kill "$(pid_of)" 2>/dev/null
  matar_bridges_antigos
  rm -f "$PIDFILE" "$SOCK"
  return 0
}

# ---------------------------------------------------------------- cadeado do start/stop

# Um `start` e um `stop` nunca podem correr ao mesmo tempo: o `stop` apagava o pidfile de um `start`
# que acabara de subir, e dois `start` davam dois bridges (visto no S10+, 2026-10-21).
#
# Cadeado por `mkdir` com o **pid do dono** lá dentro: se o dono morrer (a app foi morta a meio, o
# `su` foi cortado), o cadeado fica órfão e é retirado — senão o daemon nunca mais subia e cada
# tentativa deixava um `sh` pendurado à espera. Espera-se no máximo ~8 s.
LOCK="$BASE/run/start.lock"
lock_obter() {
  mkdir -p "$BASE/run" 2>/dev/null || true
  i=0
  while ! mkdir "$LOCK" 2>/dev/null; do
    DONO="$(cat "$LOCK/pid" 2>/dev/null)"
    if [ -n "$DONO" ] && ! kill -0 "$DONO" 2>/dev/null; then
      rm -rf "$LOCK" 2>/dev/null || true
      continue
    fi
    i=$((i + 1))
    [ "$i" -le 8 ] || return 1
    sleep 1
  done
  echo $$ > "$LOCK/pid" 2>/dev/null || true
  return 0
}
lock_largar() { rm -rf "$LOCK" 2>/dev/null || true; }

case "${1:-}" in

# ---------------------------------------------------------------- motor ACP
start)
  if ! lock_obter; then
    # Não se esperou para sempre. Antes de avançar, olha-se para o **porto**: se já há um daemon a
    # ouvi-lo (o outro `start` acabou de subir, ou o pidfile ainda não foi escrito), este não tem
    # nada a fazer — e um segundo bridge que perdesse o porto só deixava ruído no log (S10+,
    # 2026-10-21: três `EADDRINUSE` em cinco minutos, todos de um `start` que chegou tarde).
    if alive || port_open "$(porto_da_base)"; then
      echo "já está a correr (porto $(porto_da_base))"
      exit 0
    fi
    echo "aviso: outro start/stop está a correr — a avançar à mesma"
  fi
  trap 'lock_largar' EXIT
  # O porto vem primeiro, e **antes** do `alive`: uma instalação antiga (feita pela app antes de
  # `home/port` existir) tem o daemon vivo no porto do root. Escrever o porto e reiniciar é o que
  # a migra para o porto do modo, em vez de a deixar a colidir com o daemon root.
  ANTES="$(cat "$BASE/home/port" 2>/dev/null | tr -d '[:space:]')"
  PORTO="$(garantir_porto)"
  if alive; then
    if [ "$ANTES" = "$PORTO" ]; then echo "já está a correr (pid $(pid_of), porto $PORTO)"; exit 0; fi
    echo "a reiniciar o daemon: o porto passou de ${ANTES:-?} para $PORTO"
    # Sem passar pelo `stop`: o cadeado já é nosso (o `stop` voltaria a pedi-lo e ficava à espera).
    parar_de_facto >/dev/null 2>&1 || true
  fi
  # Um daemon antigo sem pidfile válido (reinstalação, pid reaproveitado) ficava a ocupar o porto
  # e o novo não subia — chegou a haver **dois** bridges ao mesmo tempo. Antes de arrancar,
  # procura-os pelo caminho do bridge, mata-os e **espera** (ver `matar_bridges_antigos`).
  matar_bridges_antigos
  [ -x "$NODE" ] || { echo "ERRO: falta $NODE (corre daemon/install.sh)"; exit 1; }
  export CACHALOTE_PORT="$PORTO"
  mkdir -p "$BASE/run" "$BASE/logs" "$BASE/tmp"
  export CACHALOTE_BASE="$BASE"
  nohup "$NODE" "$BASE/bridge.cjs" >>"$BASE/logs/daemon-console.log" 2>&1 &
  echo $! > "$PIDFILE"
  # Proteger do low-memory killer: o daemon não é uma app em primeiro plano e, sem isto, o
  # Android mata-o em pressão de memória. -800 é o valor que o próprio sistema usa para
  # processos quase-críticos (o mínimo é -1000).
  echo -800 > "/proc/$!/oom_score_adj" 2>/dev/null || true
  sleep 2
  if alive; then echo "arrancado (pid $(pid_of), porto $PORTO)"; else echo "FALHOU — ver $BASE/logs/daemon.log"; tail -n 20 "$BASE/logs/daemon.log" "$BASE/logs/daemon-console.log"; exit 1; fi
  ;;
watchdog)
  # Mantém o daemon vivo: arranca-o se estiver parado e volta a arrancar se morrer. É o que o
  # service.d do Magisk corre no arranque (ver daemon/cachalote.service.sh). Sem isto, um daemon
  # morto (LMK, kernel, crash) ficava morto até alguém reparar.
  #
  # **Um só por base.** Já houve três encadeados (`watchdog` a arrancar `watchdog`), cada um a
  # varrer /proc a cada 30 s — e um deles ficou com um `tr` a 100 % de CPU (S10+, 2026-10-21).
  # Quem chega depois sai: o que está a vigiar já vigia por todos.
  OUTRO="$(pgrep -f "$BASE/bin/cachalote watchdog" 2>/dev/null | grep -v "^$$\$" | head -1)"
  if [ -n "$OUTRO" ]; then echo "já há um watchdog a vigiar (pid $OUTRO)"; exit 0; fi
  INTERVAL="${2:-30}"
  LOG="$BASE/logs/watchdog.log"
  mkdir -p "$BASE/logs"
  echo "$(date -Iseconds 2>/dev/null || date) watchdog: a vigiar (intervalo ${INTERVAL}s)" >> "$LOG"
  while true; do
    if ! alive; then
      echo "$(date -Iseconds 2>/dev/null || date) watchdog: daemon em baixo, a arrancar" >> "$LOG"
      "$0" start >> "$LOG" 2>&1
    fi
    sleep "$INTERVAL"
  done
  ;;
# ---------------------------------------------------------------- doctor
ctl)
  # Cliente de controlo pelo socket unix: `cachalote ctl cachalote.status` ou
  # `cachalote ctl cachalote.host.call '{"capability":"status","params":{}}'`.
  METHOD="${2:-cachalote.status}"
  PARAMS="${3:-{\}}"
  # `@/caminho/ficheiro.json` lê os parâmetros de um ficheiro: evita o inferno de aspas quando
  # isto é chamado por dentro de `su -c '…'` (ver tools/vscreen-tool-test.sh).
  case "$PARAMS" in
    @*)
      FICHEIRO="${PARAMS#@}"
      [ -r "$FICHEIRO" ] || { echo "ERRO: não consigo ler $FICHEIRO" >&2; exit 1; }
      PARAMS="$(cat "$FICHEIRO")"
      ;;
  esac
  [ -S "$SOCK" ] || { echo "ERRO: socket ausente ($SOCK) — o daemon está a correr?" >&2; exit 1; }
  TMP="$BASE/tmp/ctl.$$.cjs"
  mkdir -p "$BASE/tmp"
  cat > "$TMP" <<'CTLJS'
const net = require("node:net");
const [sock, method, params] = process.argv.slice(2);
const s = net.connect(sock);
let buf = "", id = 1, authed = false;
const send = (m, p) => s.write(JSON.stringify({ jsonrpc: "2.0", id: id++, method: m, params: p }) + "\n");
s.on("connect", () => send("cachalote.auth", { token: require("node:fs").readFileSync(process.env.TOKEN_FILE, "utf8").trim(), client: "tool" }));
s.on("data", (c) => {
  buf += c.toString();
  let i;
  while ((i = buf.indexOf("\n")) >= 0) {
    const line = buf.slice(0, i); buf = buf.slice(i + 1);
    if (!line.trim()) continue;
    const m = JSON.parse(line);
    if (m.id === 1 && !authed) { authed = true; send(method, JSON.parse(params)); continue; }
    if (m.error) { console.error(JSON.stringify(m.error)); process.exit(1); }
    console.log(JSON.stringify(m.result, null, 1)); process.exit(0);
  }
});
s.on("error", (e) => { console.error(e.message); process.exit(1); });
setTimeout(() => { console.error("tempo esgotado"); process.exit(1); }, 60000);
CTLJS
  TOKEN_FILE="$BASE/home/app.token" "$NODE" "$TMP" "$SOCK" "$METHOD" "$PARAMS"
  RC=$?
  rm -f "$TMP"
  exit $RC
  ;;
doctor)
  FALHAS=0; AVISOS=0
  ok()   { echo "  [ok]  $1"; }
  warn() { echo "  [!!]  $1"; AVISOS=$((AVISOS+1)); }
  bad()  { echo "  [XX]  $1"; FALHAS=$((FALHAS+1)); }
  echo "== cachalote doctor =="
  echo "base: $BASE"
  echo
  echo "-- ficheiros"
  [ -x "$NODE" ] && ok "runtime Node ($("$NODE" -v 2>/dev/null))" || bad "falta o runtime Node ($NODE)"
  [ -f "$BASE/bridge.cjs" ] && ok "ponte (bridge.cjs)" || bad "falta $BASE/bridge.cjs"
  [ -f "$BASE/bin/cachalote" ] && ok "CLI" || bad "falta $BASE/bin/cachalote"
  [ -f "$BASE/kernel/dsh/node_modules/@deepseek-ai/dsh/lib/bin.js" ] && ok "kernel do DSH" || bad "falta o kernel (tools/prepare-kernel-zip.sh)"
  [ -f "$BASE/kernel/dsh/node_modules/@deepseek-ai/dsh/package.json" ] && ok "versão do kernel: $(grep -m1 '"version"' "$BASE/kernel/dsh/node_modules/@deepseek-ai/dsh/package.json" | tr -d ' ",' | cut -d: -f2)" || true
  # De onde veio esta árvore? Sem marca não se sabe — aconteceu olhar para o telefone e não haver
  # como responder. A marca é escrita por tools/extract-kernel.cjs.
  if [ -f "$BASE/kernel/.cachalote-origem" ]; then
    ok "origem do kernel: $(sed -n 's/.*"origem": *"\([^"]*\)".*/\1/p' "$BASE/kernel/.cachalote-origem") $(sed -n 's/.*"versao": *"\([^"]*\)".*/\1/p' "$BASE/kernel/.cachalote-origem")"
  else
    warn "kernel sem marca de origem (não se sabe se veio do npm ou do app.asar)"
  fi
  [ -f "$BASE/home/cordis.patch.yml" ] && ok "camada de patch do perfil" || warn "sem home/cordis.patch.yml (usa o perfil por omissão)"
  PLUGIN="$(grep -o "/[^']*dsh-tool-cachalote/lib/index.js" "$BASE/home/cordis.patch.yml" 2>/dev/null | head -1)"
  if [ -n "$PLUGIN" ]; then
    [ -f "$PLUGIN" ] && ok "plugin das capacidades android_*" || bad "o perfil aponta para $PLUGIN, que não existe"
  else
    warn "o perfil não insere o plugin das capacidades (o agente não terá ferramentas android_*)"
  fi
  echo
  echo "-- chave do provedor"
  if [ -f "$BASE/home/.env" ]; then
    [ "$(grep -c '^DEEPSEEK_API_KEY=' "$BASE/home/.env" 2>/dev/null)" -ge 1 ] && ok "DEEPSEEK_API_KEY presente" || bad "sem DEEPSEEK_API_KEY em home/.env (daemon/set-key.sh)"
    MODO="$(stat -c %a "$BASE/home/.env" 2>/dev/null)"
    [ "$MODO" = "600" ] && ok "home/.env com modo 600" || warn "home/.env com modo $MODO (devia ser 600)"
  else
    bad "falta home/.env"
  fi
  echo
  echo "-- daemon"
  if alive; then
    PID="$(pid_of)"
    ok "a correr (pid $PID)"
    ADJ="$(cat "/proc/$PID/oom_score_adj" 2>/dev/null)"
    if [ -n "$ADJ" ] && [ "$ADJ" -le -500 ] 2>/dev/null; then ok "protegido do LMK (oom_score_adj=$ADJ)"; else warn "sem protecção de memória (oom_score_adj=${ADJ:-?})"; fi
  else
    bad "parado — arranca com: cachalote start (ou liga o watchdog)"
  fi
  # Pelo caminho **desta** base: o padrão global casava com o watchdog do daemon root e a base do
  # Shizuku dizia «watchdog a vigiar» sem ter nenhum (S10+, 2026-10-21).
  #
  # Fora de /data/adb **não há** service.d (é do Magisk), logo não há watchdog para vigiar: avisar
  # «não está a correr» era um aviso que ninguém podia resolver — e um aviso impossível ensina a
  # ignorar avisos.
  if [ "$BASE" != "/data/adb/cachalote" ]; then
    ok "sem watchdog neste modo (o service.d é do root; aqui o daemon é arrancado pela app)"
  elif pgrep -f "$BASE/bin/cachalote watchdog" >/dev/null 2>&1; then
    ok "watchdog a vigiar"
  else
    warn "watchdog não está a correr (service.d liga-o no arranque)"
  fi
  echo
  echo "-- canal e motor"
  # O porto vem do ficheiro da base — e, se faltar, da regra da base (39731 no root, 39733 fora
  # dele). Com o valor fixo, o doctor mentia sobre o canal (apanhado ao re-verificar o Shizuku).
  PORTO="$(porto_da_base)"
  if port_open "$PORTO"; then ok "TCP $PORTO à escuta"; else bad "porto $PORTO sem resposta"; fi
  [ -S "$SOCK" ] && ok "socket unix" || warn "socket unix ausente (normal em /data/local/tmp — o SELinux recusa)"
  ST=""
  [ -S "$SOCK" ] && ST="$("$0" ctl cachalote.status 2>/dev/null | tr -d '\n ' )"
  case "$ST" in
    *'"engine":true'*) ok "motor (engine) a responder" ;;
    *'"engine":false'*) warn "motor em baixo — a ponte reinicia-o; vê logs/engine.log" ;;
    # O motor procura-se **pelo kernel desta base**: com `pgrep -f "dsh/lib/bin.js"` a base parada
    # dizia «motor presente» por causa do motor da *outra* base (S10+, 2026-10-21: o daemon do
    # Shizuku, parado, dizia «motor: a correr» porque o root estava de pé).
    *) pgrep -f "$BASE/kernel/dsh/node_modules/@deepseek-ai/dsh/lib/bin.js" >/dev/null 2>&1 &&
         ok "processo do motor presente" || warn "não consegui confirmar o motor" ;;
  esac
  if [ -S "$SOCK" ]; then
    case "$ST" in
      *'"appConnected":true'*) ok "app ligada ao daemon" ;;
      *'"appConnected":false'*) warn "app não está ligada (abre a app Cachalote)" ;;
      *'"engine":true'*) ok "motor a responder ao status" ;;
      *) warn "não consegui ler o estado pelo canal de controlo" ;;
    esac
  fi
  echo
  echo "-- app e capacidades (ponta a ponta)"
  if [ -S "$SOCK" ]; then
    # O JSON vem indentado (`JSON.stringify(..., 1)`): tirar espaços e mudanças de linha, senão
    # os padrões `"campo":valor` não casam (foi um bug de diagnóstico do próprio doctor).
    CAPS="$("$0" ctl cachalote.host.call '{"capability":"status","params":{}}' 2>/dev/null | tr -d '\n ')"
    case "$CAPS" in
      *'"accessibility":true'*) ok "acessibilidade ligada (ver/tocar/escrever no ecrã)" ;;
      *'"accessibility":false'*) warn "acessibilidade desligada — liga em Definições → Acessibilidade → Cachalote" ;;
      *'"error"'*) warn "a app recusou/errou as capacidades: $(printf '%s' "$CAPS" | head -c 120)" ;;
      *) if [ -n "$ST" ] && printf '%s' "$ST" | grep -q '"appConnected":true'; then
           warn "a app está ligada mas não respondeu às capacidades (tem o serviço a funcionar?)"
         else
           warn "a app não está ligada (abre a app Cachalote para testar as capacidades)"
         fi ;;
    esac
    case "$CAPS" in
      *'"notifications":true'*) ok "notificações permitidas" ;;
      *'"notifications":false'*) warn "notificações não permitidas" ;;
    esac
  fi
  echo
  echo "-- espaço e registos"
  DF="$(df -h "$BASE" 2>/dev/null | tail -1 | awk '{print $4}')"
  [ -n "$DF" ] && ok "espaço livre em $BASE: $DF" || warn "não consegui ler o espaço em disco"
  if [ -f "$BASE/logs/engine.log" ]; then
    # As entradas contam-se por **nome**, não por linha: o motor avisa «1 entry did not activate»
    # de cada vez que arranca, portanto contar as ocorrências no log dava «8 entradas» para a
    # mesma (`plugin-exemplo`) que falha desde sempre (visto no S10+ em 2026-10-21).
    # Só o **último arranque** do motor (a marca `--- motor arrancado ... ---` que a ponte escreve
    # antes de cada arranque): o log é acrescentado e nunca é limpo, e uma entrada que falhava
    # ontem continuava a ser reportada hoje.
    ENTRADAS="$(awk '/^--- motor arrancado/{buf=""} {buf=buf $0 "\n"} END{printf "%s", buf}' \
      "$BASE/logs/engine.log" 2>/dev/null | grep 'failed to import' | sed 's/ (file:.*//' | sort -u)"
    if [ -z "$ENTRADAS" ]; then
      ok "motor sem entradas por activar"
    else
      N="$(printf '%s\n' "$ENTRADAS" | wc -l | tr -d ' ')"
      if [ "$N" = "1" ]; then
        warn "1 entrada do motor não activou: $(printf '%s' "$ENTRADAS" | tr '\n' ' ')"
      else
        warn "$N entradas do motor não activaram: $(printf '%s' "$ENTRADAS" | tr '\n' ' ')"
      fi
    fi
  fi
  if [ -f "$BASE/logs/daemon.log" ]; then
    # Só a cauda: um ERRO de ontem não é um problema de hoje (e um log que nunca é limpo passava
    # a mentir para sempre).
    U="$(tail -n 300 "$BASE/logs/daemon.log" 2>/dev/null | grep -c "ERRO")"
    [ "${U:-0}" = "0" ] && ok "ponte sem ERRO no registo" || warn "$U ERRO no registo da ponte (vê logs/daemon.log)"
  fi
  echo
  # Plural a sério, não "$N problema(s)": o resultado vai direto para o ecrã do Resumo da app
  # e o sufixo «(s)» lia-se como texto por acabar (visto no S10+ em 2026-10-15).
  plural() { # plural N singular plural
    if [ "$1" = "1" ]; then echo "$1 $2"; else echo "$1 $3"; fi
  }
  P="$(plural "$FALHAS" problema problemas)"
  A="$(plural "$AVISOS" aviso avisos)"
  if [ "$FALHAS" = "0" ] && [ "$AVISOS" = "0" ]; then
    echo "resultado: tudo bem"
  elif [ "$FALHAS" = "0" ]; then
    echo "resultado: $A, nenhum problema"
  elif [ "$AVISOS" = "0" ]; then
    echo "resultado: $P"
  else
    echo "resultado: $P e $A"
  fi
  [ "$FALHAS" = "0" ]
  ;;

stop)
  # O `stop` entra no **mesmo** cadeado do `start`: sem isto, um `stop` lançado enquanto o laço de
  # reconexão da app arrancava um daemon novo apagava o pidfile dele e o `status` passava a dizer
  # «PARADO» com o daemon à escuta no porto (visto no S10+ em 2026-10-21).
  lock_obter || true
  trap 'lock_largar' EXIT
  if parar_de_facto; then echo "parado"; else echo "não está a correr"; fi
  ;;
restart) "$0" stop; "$0" start ;;
status)
  echo "== cachalote =="
  echo "base   : $BASE"
  echo "perfil : ${CACHALOTE_PROFILE:-acp}"
  if alive; then echo "daemon : a correr (pid $(pid_of))"; else echo "daemon : PARADO"; fi
  if [ -S "$SOCK" ]; then echo "socket : $SOCK (modo $(stat -c %a "$SOCK" 2>/dev/null))"; else echo "socket : ausente"; fi
  if pgrep -f "$BASE/kernel/dsh/node_modules/@deepseek-ai/dsh/lib/bin.js" >/dev/null 2>&1; then echo "motor  : a correr"; else echo "motor  : parado"; fi
  echo "porto  : $(porto_da_base)"
  echo "sessões: $(ls "$BASE/home/sessions" 2>/dev/null | wc -l) (direcções de projecto)"
  if [ -x "$NODE" ] && [ -S "$SOCK" ]; then
    echo "handshake:"
    "$NODE" -e '
      const net=require("node:net");
      const s=net.connect(process.argv[1]);
      let buf="", done=false;
      const fin=(m)=>{ if(done)return; done=true; console.log("  "+m); try{s.destroy()}catch{}; process.exit(0) };
      s.on("connect",()=>s.write(JSON.stringify({jsonrpc:"2.0",id:1,method:"initialize",params:{protocolVersion:1,clientCapabilities:{},clientInfo:{name:"cachalote-status",version:"1"}}})+"\n"));
      s.on("data",(b)=>{ buf+=b; let i; while((i=buf.indexOf("\n"))>=0){ const l=buf.slice(0,i); buf=buf.slice(i+1); if(!l.trim())continue; try{const m=JSON.parse(l); if(m.id===1){ fin(m.result?("OK "+(m.result.agentInfo?.name||"")+" "+(m.result.agentInfo?.version||"")):("ERRO "+JSON.stringify(m.error))); } }catch{} } });
      s.on("error",(e)=>fin("falha de socket: "+e.message));
      setTimeout(()=>fin("sem resposta do motor"),8000);
    ' "$SOCK"
  fi
  ;;
logs) tail -n "${2:-80}" "$BASE/logs/daemon.log"; echo "--- engine ---"; tail -n "${2:-40}" "$BASE/logs/engine.log" ;;

# ---------------------------------------------------------------- app
app-token)
  # Provisionamento do app: imprime o token do canal TCP (a app guarda-o).
  # --rotate gera um novo (invalida o antigo).
  if [ "${2:-}" = "--rotate" ]; then rm -f "$BASE/home/app.token"; fi
  if [ ! -s "$BASE/home/app.token" ]; then
    "$NODE" -e 'const c=require("node:crypto"),f=require("node:fs");f.writeFileSync(process.argv[1],c.randomBytes(16).toString("hex")+"\n",{mode:0o600});' "$BASE/home/app.token"
  fi
  chmod 600 "$BASE/home/app.token" 2>/dev/null
  cat "$BASE/home/app.token"
  ;;
app-info)
  TOK="$("$0" app-token)"
  printf '{"port":%s,"token":"%s","base":"%s","profile":"%s"}\n' "$(porto_da_base)" "$TOK" "$BASE" "${CACHALOTE_PROFILE:-acp}"
  ;;

# ---------------------------------------------------------------- interface web completa
web-start)
  # Engine separado com o perfil "web" do DSH (paridade total: definições, modelos,
  # plugins). Corre ao lado do motor ACP, em 127.0.0.1:3080.
  PORT="${CACHALOTE_WEB_PORT:-3080}"
  if [ -f "$WEBPID" ] && kill -0 "$(cat "$WEBPID")" 2>/dev/null; then echo "já está a correr (pid $(cat "$WEBPID")) em $PORT"; exit 0; fi
  mkdir -p "$BASE/run" "$BASE/logs" "$BASE/tmp"
  nohup env DSH_HOME="$BASE/home" HOME="$BASE" TMPDIR="$BASE/tmp" TERM=dumb \
      PATH="$BASE/bin:$BASE/runtime/bin:/system/bin:/system/xbin" \
      LD_LIBRARY_PATH="$BASE/runtime/lib" \
      "$NODE" --expose-internals "$BASE/kernel/dsh/node_modules/@deepseek-ai/dsh/lib/bin.js" \
      --profile web --host 127.0.0.1 --port "$PORT" >>"$BASE/logs/web.log" 2>&1 &
  echo $! > "$WEBPID"
  for i in $(seq 1 40); do
    sleep 1
    if port_open "$PORT"; then
      # O perfil `web` exige autenticação: imprime um URL com token. Guardamo-lo para a app.
      URL="$(grep -aoE "http://127\.0\.0\.1:[0-9]+/\?token=[A-Za-z0-9_-]+" "$BASE/logs/web.log" 2>/dev/null | tail -1)"
      if [ -n "$URL" ]; then printf '%s\n' "$URL" > "$BASE/home/web.url"; chmod 600 "$BASE/home/web.url"; fi
      echo "interface web pronta: ${URL:-http://127.0.0.1:$PORT/} (pid $(cat "$WEBPID"))"
      exit 0
    fi
  done
  echo "não ficou pronta em 40s — ver $BASE/logs/web.log"; exit 1
  ;;
web-stop)
  # Faltava: o `web-stop` estava na lista de comandos do `uso` mas não existia, e o motor web
  # (um Node inteiro com o perfil `web`) não tinha como ser parado pela CLI — ficava a correr
  # depois de se sair do ecrã do «Modo completo» (visto no S10+ em 2026-10-16).
  parou=0
  if [ -f "$WEBPID" ]; then
    P="$(cat "$WEBPID" 2>/dev/null)"
    if [ -n "$P" ] && kill -0 "$P" 2>/dev/null; then kill "$P" 2>/dev/null; parou=1; fi
  fi
  # Também pelo caminho: o pid do ficheiro pode estar velho (ou o processo ter sido levantado
  # por outro caminho) e o motor tem de sair à mesma.
  for p in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
    [ "$p" = "$$" ] && continue
    if [ -r "/proc/$p/cmdline" ] && tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q -- "--profile web"; then
      kill "$p" 2>/dev/null && parou=1
    fi
  done
  sleep 2
  # Quem não saiu a bem, sai à força.
  for p in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
    [ "$p" = "$$" ] && continue
    if [ -r "/proc/$p/cmdline" ] && tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q -- "--profile web"; then
      kill -9 "$p" 2>/dev/null || true
    fi
  done
  rm -f "$WEBPID" "$BASE/home/web.url"
  [ "$parou" = 1 ] && echo "interface web parada" || echo "interface web já estava parada"
  ;;
web-url)
  # URL autenticado da interface web (a app usa-o no WebView).
  if [ -s "$BASE/home/web.url" ]; then cat "$BASE/home/web.url";
  else grep -aoE "http://127\.0\.0\.1:[0-9]+/\?token=[A-Za-z0-9_-]+" "$BASE/logs/web.log" 2>/dev/null | tail -1; fi
  ;;
web-watchdog)
  # Mantém o daemon vivo: arranca-o se estiver parado e volta a arrancar se morrer. É o que o
  # service.d do Magisk corre no arranque (ver daemon/cachalote.service.sh). Sem isto, um daemon
  # morto (LMK, kernel, crash) ficava morto até alguém reparar.
  INTERVAL="${2:-30}"
  LOG="$BASE/logs/watchdog.log"
  mkdir -p "$BASE/logs"
  echo "$(date -Iseconds 2>/dev/null || date) watchdog: a vigiar (intervalo ${INTERVAL}s)" >> "$LOG"
  while true; do
    if ! alive; then
      echo "$(date -Iseconds 2>/dev/null || date) watchdog: daemon em baixo, a arrancar" >> "$LOG"
      "$0" start >> "$LOG" 2>&1
    fi
    sleep "$INTERVAL"
  done
  ;;
stop)
  if [ -f "$WEBPID" ]; then kill "$(cat "$WEBPID")" 2>/dev/null; rm -f "$WEBPID"; echo "interface web parada"; else echo "não estava a correr"; fi
  ;;
web-status)
  PORT="${CACHALOTE_WEB_PORT:-3080}"
  if [ -f "$WEBPID" ] && kill -0 "$(cat "$WEBPID")" 2>/dev/null; then
    if port_open "$PORT"; then echo "interface web: a correr em http://127.0.0.1:$PORT (pid $(cat "$WEBPID"))"; else echo "interface web: processo vivo mas porta $PORT fechada"; fi
  else
    echo "interface web: parada"
  fi
  ;;
env) sed -E 's/^(.*=.{0,4}).*/\1****/' "$BASE/home/.env" 2>/dev/null || echo "(sem $BASE/home/.env)" ;;

# ---------------------------------------------------------------- chave (valor por stdin)
key-set)
  # Uso: printf '%s\n' "<chave>" | cachalote key-set [NOME]
  NAME="${2:-DEEPSEEK_API_KEY}"
  VALUE="$(cat)"
  [ -n "$VALUE" ] || { echo "ERRO: chave vazia (envia o valor por stdin)" >&2; exit 1; }
  mkdir -p "$BASE/home"
  TMP="$BASE/home/.env.new"
  { grep -v "^$NAME=" "$BASE/home/.env" 2>/dev/null || true; printf '%s=%s\n' "$NAME" "$VALUE"; } > "$TMP"
  mv "$TMP" "$BASE/home/.env"
  chmod 600 "$BASE/home/.env"
  echo "gravado: $NAME (${#VALUE} caracteres) em $BASE/home/.env"
  "$0" restart >/dev/null 2>&1 || true
  ;;
key-remove)
  NAME="${2:-DEEPSEEK_API_KEY}"
  if [ -f "$BASE/home/.env" ]; then
    grep -v "^$NAME=" "$BASE/home/.env" > "$BASE/home/.env.new" 2>/dev/null || true
    mv "$BASE/home/.env.new" "$BASE/home/.env"; chmod 600 "$BASE/home/.env"
  fi
  echo "removido: $NAME"
  "$0" restart >/dev/null 2>&1 || true
  ;;
key-status)
  NAME="${2:-DEEPSEEK_API_KEY}"
  if grep -q "^$NAME=" "$BASE/home/.env" 2>/dev/null; then echo "presente"; else echo "ausente"; fi
  ;;
*) echo "uso: cachalote start|stop|restart|watchdog [seg]|ctl <método> [params]|doctor|status|logs [n]|env|app-token [--rotate]|app-info|web-start|web-stop|web-status|web-url|key-set|key-remove|key-status"; exit 2 ;;
esac
