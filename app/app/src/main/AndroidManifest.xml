<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fala com o daemon em 127.0.0.1 (canal de controlo autenticado por token). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- O agente pode publicar notificações (android_notify). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Serviço em primeiro plano: mantém a ligação ao motor durante turnos longos. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Shizuku: correr o daemon como shell sem root (o servidor do Shizuku autoriza o app). -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:localeConfig="@xml/locales_config"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Cachalote">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Interface web completa (modo de paridade), servida pelo perfil `web` no telefone. -->
        <activity
            android:name=".WebModeActivity"
            android:exported="false"
            android:label="Cachalote completo" />

        <!-- Mantém a app (e o socket) vivos enquanto o agente trabalha. -->
        <service
            android:name=".CachaloteAgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Mantém a ligação ao motor do agente Cachalote para tarefas longas" />
        </service>

        <!--
          Serviço de acessibilidade: as capacidades "olhos e dedos" do agente.
          O utilizador tem de o ligar em Definições → Acessibilidade (a app oferece
          um atalho e explica porquê). Sem ele, só as notificações funcionam.
        -->
        <service
            android:name=".CachaloteAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Shizuku (modo "shell" sem root). O provider é OBRIGATÓRIO: é por ele que o servidor
          do Shizuku entrega o binder à app — sem ele, `Shizuku.pingBinder()` devolve false e o
          Shizuku regista "provider is null <package>.shizuku". O service corre no processo do
          Shizuku e dá os comandos com o uid dele (ver ShizukuShellService).
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
